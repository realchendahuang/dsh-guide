---
// 第 6 幕示意图:主对话派帮手只收结果;危险命令必须签字,没人签字默认拒绝。
const accent = '#b197fc';
const ink = '#e8ecf8';
const dim = '#9aa3c0';
const mono = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
const helpers = [60, 166];
---

<div class="diagram">
  <svg viewBox="0 0 640 380" role="img" aria-label="主对话派帮手干活只收结果;危险命令必须你签字">
    <defs>
      <marker id="dfleet-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill={accent}></path>
      </marker>
    </defs>

    <!-- 主对话 -->
    <ellipse cx="140" cy="104" rx="104" ry="46" fill="rgba(177,151,252,0.1)" stroke={accent} stroke-width="1.4"></ellipse>
    <text x="140" y="100" text-anchor="middle" font-family={mono} font-size="13" fill={ink}>主对话</text>
    <text x="140" y="120" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>(它的记事本)</text>

    <!-- 帮手 ×2 -->
    {helpers.map((cy) => (
      <>
        <ellipse cx="496" cy={cy} rx="92" ry="30" fill="rgba(177,151,252,0.08)" stroke={accent} stroke-width="1.2"></ellipse>
        <text x="496" y={cy - 3} text-anchor="middle" font-family={mono} font-size="12" fill={ink}>帮手</text>
        <text x="496" y={cy + 15} text-anchor="middle" font-family={mono} font-size="11" fill={dim}>(独立记事本)</text>
      </>
    ))}

    <!-- 派活(虚线) / 只交结果(实线) -->
    <line x1="236" y1="88" x2="392" y2="67" stroke={accent} stroke-width="1.3" stroke-dasharray="5 5" marker-end="url(#dfleet-arrow)"></line>
    <text x="314" y="62" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>派活</text>
    <line x1="392" y1="151" x2="244" y2="121" stroke={accent} stroke-width="1.5" marker-end="url(#dfleet-arrow)"></line>
    <text x="318" y="158" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>只交结果</text>

    <!-- 帮手互相看不见 -->
    <line x1="496" y1="92" x2="496" y2="134" stroke={dim} stroke-width="1.2"></line>
    <line x1="482" y1="100" x2="510" y2="126" stroke={accent} stroke-width="2"></line>
    <text x="520" y="117" font-family={mono} font-size="11" fill={dim}>互相看不见</text>

    <!-- 危险命令 → 你签字 → 才执行 -->
    <rect x="76" y="258" width="104" height="38" rx="8" fill="rgba(177,151,252,0.08)" stroke={accent} stroke-width="1.2"></rect>
    <text x="128" y="282" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>危险命令</text>
    <line x1="184" y1="277" x2="260" y2="277" stroke={accent} stroke-width="1.4" marker-end="url(#dfleet-arrow)"></line>
    <rect x="268" y="258" width="104" height="38" rx="8" fill="rgba(177,151,252,0.08)" stroke={accent} stroke-width="1.2"></rect>
    <text x="320" y="282" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>你签字</text>
    <line x1="376" y1="277" x2="452" y2="277" stroke={accent} stroke-width="1.4" marker-end="url(#dfleet-arrow)"></line>
    <rect x="460" y="258" width="104" height="38" rx="8" fill="rgba(177,151,252,0.08)" stroke={accent} stroke-width="1.2"></rect>
    <text x="512" y="282" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>才执行</text>

    <!-- 没人签字 → 默认拒绝 -->
    <text x="216" y="344" text-anchor="middle" font-family={mono} font-size="12" fill={dim}>没人签字</text>
    <line x1="188" y1="330" x2="244" y2="354" stroke={accent} stroke-width="2.2" stroke-linecap="round"></line>
    <line x1="244" y1="330" x2="188" y2="354" stroke={accent} stroke-width="2.2" stroke-linecap="round"></line>
    <line x1="258" y1="340" x2="300" y2="340" stroke={dim} stroke-width="1.3" marker-end="url(#dfleet-arrow)"></line>
    <text x="316" y="345" font-family={mono} font-size="12" fill={ink}>默认拒绝</text>
  </svg>
</div>
