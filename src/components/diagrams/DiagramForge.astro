---
// 第 5 幕示意图:工作台快满 → 写前情提要 → 提要 + 最近几页保留 + 旧账沉底。
const accent = '#f783ac';
const ink = '#e8ecf8';
const dim = '#9aa3c0';
const mono = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
const full = Array.from({ length: 8 }, (_, i) => 155 + i * 42);
const recent = [300, 348, 396];
const sunk = [108, 150, 192, 234, 276];
---

<div class="diagram">
  <svg viewBox="0 0 640 360" role="img" aria-label="写前情提要:旧账被一页提要盖住,原件沉底保留">
    <defs>
      <marker id="dforge-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill={accent}></path>
      </marker>
    </defs>

    <!-- before:工作台快满了 -->
    <text x="320" y="30" text-anchor="middle" font-family={mono} font-size="12" fill={accent}>工作台快满了</text>
    {full.map((x) => (
      <rect x={x} y="44" width="36" height="36" rx="6" fill="rgba(247,131,172,0.28)" stroke={accent} stroke-width="1.2"></rect>
    ))}

    <!-- 写前情提要 -->
    <line x1="320" y1="92" x2="320" y2="124" stroke={accent} stroke-width="1.5" marker-end="url(#dforge-arrow)"></line>
    <text x="336" y="112" font-family={mono} font-size="12" fill={dim}>写前情提要</text>

    <!-- after:前情提要(一页) -->
    <path d="M 150 148 L 214 192 L 150 236 L 86 192 Z" fill="rgba(247,131,172,0.16)" stroke={accent} stroke-width="1.4"></path>
    <text x="150" y="188" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>前情提要</text>
    <text x="150" y="208" text-anchor="middle" font-family={mono} font-size="11" fill={ink}>(一页)</text>

    <!-- after:最近几页原样保留 -->
    <text x="366" y="162" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>最近几页原样保留</text>
    {recent.map((x) => (
      <rect x={x} y="174" width="36" height="36" rx="6" fill="rgba(247,131,172,0.28)" stroke={accent} stroke-width="1.2"></rect>
    ))}

    <!-- 旧账沉底,一页没撕 -->
    <rect x="86" y="262" width="380" height="66" rx="10" fill="none" stroke={dim} stroke-width="1" stroke-dasharray="6 5" opacity="0.7"></rect>
    {sunk.map((x) => (
      <rect x={x} y="280" width="30" height="30" rx="5" fill="rgba(154,163,192,0.12)" stroke={dim} stroke-width="1" opacity="0.8"></rect>
    ))}
    <text x="326" y="300" font-family={mono} font-size="11" fill={dim}>旧账沉底,一页没撕</text>
  </svg>
</div>
