---
// 第 4 幕示意图:只加不删的账本 → 现场整理 → 外脑看到的聊天记录。
const accent = '#63e6be';
const ink = '#e8ecf8';
const dim = '#9aa3c0';
const mono = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
const rows = ['你说的话', '它的回答', '跑的命令', '命令的结果'];
---

<div class="diagram">
  <svg viewBox="0 0 640 240" role="img" aria-label="账本经现场整理后变成外脑看到的聊天记录">
    <defs>
      <marker id="dlog-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M 0 0 L 10 5 L 0 10 z" fill={accent}></path>
      </marker>
    </defs>

    <!-- 左:账本 -->
    <text x="119" y="34" text-anchor="middle" font-family={mono} font-size="12" fill={accent}>只加不删</text>
    <rect x="24" y="46" width="190" height="150" rx="8" fill="rgba(99,230,190,0.06)" stroke={accent} stroke-width="1.2"></rect>
    {rows.map((r, i) => (
      <>
        <text x="42" y={78 + i * 32} font-family={mono} font-size="12" fill={ink}>{r}</text>
        <line x1="38" y1={88 + i * 32} x2="198" y2={88 + i * 32} stroke="rgba(99,230,190,0.2)" stroke-width="1"></line>
      </>
    ))}

    <!-- 箭头 1 -->
    <line x1="222" y1="121" x2="286" y2="121" stroke={accent} stroke-width="1.5" marker-end="url(#dlog-arrow)"></line>

    <!-- 中:漏斗 -->
    <path d="M 298 76 L 386 76 L 352 128 L 352 162 L 332 162 L 332 128 Z" fill="rgba(99,230,190,0.1)" stroke={accent} stroke-width="1.2"></path>
    <text x="342" y="196" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>每次问外脑前,</text>
    <text x="342" y="214" text-anchor="middle" font-family={mono} font-size="11" fill={dim}>现场整理</text>

    <!-- 箭头 2 -->
    <line x1="394" y1="121" x2="450" y2="121" stroke={accent} stroke-width="1.5" marker-end="url(#dlog-arrow)"></line>

    <!-- 右:对话框 -->
    <rect x="458" y="72" width="160" height="72" rx="14" fill="rgba(99,230,190,0.08)" stroke={accent} stroke-width="1.2"></rect>
    <path d="M 486 144 L 478 162 L 500 144 Z" fill="rgba(99,230,190,0.08)" stroke={accent} stroke-width="1.2"></path>
    <text x="538" y="106" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>外脑看到的</text>
    <text x="538" y="128" text-anchor="middle" font-family={mono} font-size="12" fill={ink}>聊天记录</text>
  </svg>
</div>
